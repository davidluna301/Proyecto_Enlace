{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "src/views/**",
          "src/public/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/vercel.ts" }
  ]
}
