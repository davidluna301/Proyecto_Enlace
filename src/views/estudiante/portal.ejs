<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Portal Estudiantil – Agenda tu Cita | ENLACE UCC</title>
  <meta name="description" content="Espacio confidencial para estudiantes de la Universidad Cooperativa de Colombia. Agenda tu cita de bienestar y acompañamiento psicológico.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <style>
    :root {
      --ucc-primary: #189fba;
      --ucc-primary-dark: #0e6577;
      --ucc-primary-soft: #e8f5f7;
      --ucc-secondary: #74b033;
      --ucc-secondary-soft: #eff6e8;
      --ucc-accent: #bbc400;
      --ucc-bg: #f5f9fa;
      --ucc-card: #ffffff;
      --ucc-text: #1f2933;
      --ucc-muted: #52616b;
      --ucc-border: #e2e8f0;
      --ucc-radius: 18px;
      --ucc-shadow: 0 12px 36px rgba(22, 57, 67, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--ucc-bg);
      background-image: 
        radial-gradient(ellipse at 10% 15%, #e0f4f7 0%, transparent 40%),
        radial-gradient(ellipse at 90% 85%, #eff6e8 0%, transparent 45%);
      color: var(--ucc-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
    }

    /* ── Header Flotante ── */
    .portal-nav {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--ucc-border);
      padding: 0.85rem 2rem;
      position: sticky;
      top: 0;
      z-index: 1000;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .portal-logo-wrap {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
    }

    .portal-brand-text {
      display: flex;
      flex-direction: column;
    }

    .portal-brand-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--ucc-primary-dark);
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .portal-brand-sub {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--ucc-muted);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .portal-nav-badges {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .badge-confidential {
      background: #eff6e8;
      color: #365b16;
      border: 1px solid #cce5b8;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.35rem 0.85rem;
      border-radius: 30px;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .badge-qr-access {
      background: #e8f5f7;
      color: var(--ucc-primary-dark);
      border: 1px solid #bce2e8;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.35rem 0.85rem;
      border-radius: 30px;
    }

    /* ── Contenedor Principal ── */
    .portal-container {
      max-width: 960px;
      margin: 2rem auto;
      padding: 0 1.25rem;
      width: 100%;
      flex-grow: 1;
    }

    /* ── Banner de Bienvenida y Motivación ── */
    .portal-hero {
      background: linear-gradient(135deg, #0e6577 0%, #189fba 60%, #74b033 100%);
      color: #ffffff;
      border-radius: 24px;
      padding: 2.25rem 2.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 16px 40px rgba(14, 101, 119, 0.2);
      position: relative;
      overflow: hidden;
    }

    .portal-hero::after {
      content: '🌱';
      position: absolute;
      right: 1.5rem;
      bottom: -1rem;
      font-size: 7.5rem;
      opacity: 0.18;
      pointer-events: none;
    }

    .portal-hero-title {
      font-size: 1.85rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    .portal-hero-desc {
      font-size: 0.98rem;
      line-height: 1.6;
      opacity: 0.95;
      max-width: 680px;
      margin-bottom: 1.25rem;
    }

    .portal-hero-strip {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(6px);
      padding: 0.65rem 1.25rem;
      border-radius: 14px;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .portal-hero-strip span {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* ── Pestañas de Navegación ── */
    .portal-tabs-nav {
      display: flex;
      gap: 0.6rem;
      background: #ffffff;
      border: 1px solid var(--ucc-border);
      border-radius: 16px;
      padding: 6px;
      margin-bottom: 2rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      flex-wrap: wrap;
    }

    .portal-tab-btn {
      flex: 1;
      min-width: 170px;
      padding: 0.8rem 1rem;
      border: none;
      background: transparent;
      color: var(--ucc-muted);
      font-weight: 700;
      font-size: 0.9rem;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .portal-tab-btn:hover {
      background: var(--ucc-primary-soft);
      color: var(--ucc-primary-dark);
    }

    .portal-tab-btn.active {
      background: var(--ucc-primary);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(24, 159, 186, 0.35);
    }

    /* ── Tarjeta Principal de Contenido ── */
    .portal-card {
      background: #ffffff;
      border: 1px solid var(--ucc-border);
      border-radius: 24px;
      padding: 2.25rem;
      box-shadow: var(--ucc-shadow);
      animation: fadeSlideUp 0.35s ease-out;
    }

    .portal-card-header {
      margin-bottom: 1.75rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--ucc-border);
    }

    .card-eyebrow {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ucc-primary);
      display: block;
      margin-bottom: 0.25rem;
    }

    .portal-card-title {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--ucc-text);
      margin-bottom: 0.25rem;
    }

    .portal-card-subtitle {
      font-size: 0.9rem;
      color: var(--ucc-muted);
      margin: 0;
    }

    /* ── Formulario de Cita ── */
    .form-section-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--ucc-primary-dark);
      margin: 1.25rem 0 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .form-label-styled {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--ucc-text);
      margin-bottom: 0.35rem;
    }

    .form-control-styled, .form-select-styled {
      border: 1.5px solid var(--ucc-border);
      border-radius: 12px;
      padding: 0.7rem 0.95rem;
      font-size: 0.92rem;
      font-family: inherit;
      color: var(--ucc-text);
      background-color: #ffffff;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .form-control-styled:focus, .form-select-styled:focus {
      border-color: var(--ucc-primary);
      box-shadow: 0 0 0 3px rgba(24, 159, 186, 0.18);
    }

    /* Selector de Psicólogos (Cards) */
    .psychologist-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .psychologist-card {
      border: 1.5px solid var(--ucc-border);
      border-radius: 14px;
      padding: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      background: #fafbfc;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .psychologist-card:hover {
      border-color: var(--ucc-primary);
      background: #f0fdfa;
      transform: translateY(-2px);
    }

    .psychologist-card.selected {
      border-color: var(--ucc-primary);
      background: #e8f5f7;
      box-shadow: 0 0 0 2px var(--ucc-primary);
    }

    .psychologist-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--ucc-primary), var(--ucc-primary-dark));
      color: #fff;
      font-weight: 800;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .psychologist-name {
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--ucc-text);
      line-height: 1.2;
    }

    .psychologist-specialty {
      font-size: 0.74rem;
      color: var(--ucc-muted);
      line-height: 1.2;
      margin-top: 2px;
    }

    /* Modalidad Selector (Cards) */
    .modality-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .modality-card {
      border: 1.5px solid var(--ucc-border);
      border-radius: 14px;
      padding: 1.1rem;
      cursor: pointer;
      text-align: center;
      background: #fafbfc;
      transition: all 0.2s;
    }

    .modality-card:hover {
      border-color: var(--ucc-primary);
      background: #f0fdfa;
    }

    .modality-card.selected {
      border-color: var(--ucc-primary);
      background: #e8f5f7;
      box-shadow: 0 0 0 2px var(--ucc-primary);
    }

    .modality-icon {
      font-size: 1.8rem;
      line-height: 1;
      display: block;
      margin-bottom: 0.4rem;
    }

    .modality-title {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--ucc-text);
    }

    .modality-sub {
      font-size: 0.75rem;
      color: var(--ucc-muted);
    }

    /* Motivos Rápidos (Chips) */
    .chips-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.75rem;
    }

    .chip-btn {
      border: 1px solid var(--ucc-border);
      background: #f8fafc;
      color: var(--ucc-muted);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35rem 0.75rem;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .chip-btn:hover {
      background: var(--ucc-primary-soft);
      color: var(--ucc-primary-dark);
      border-color: var(--ucc-primary);
    }

    .chip-btn.selected {
      background: var(--ucc-primary);
      color: #ffffff;
      border-color: var(--ucc-primary);
    }

    /* Botón de Enviar Cita */
    .btn-submit-appointment {
      background: linear-gradient(135deg, var(--ucc-primary) 0%, var(--ucc-primary-dark) 100%);
      color: #ffffff;
      border: none;
      border-radius: 14px;
      padding: 1.1rem 2rem;
      font-size: 1.05rem;
      font-weight: 800;
      width: 100%;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 8px 24px rgba(24, 159, 186, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-submit-appointment:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(14, 101, 119, 0.4);
      background: linear-gradient(135deg, #1aaecb 0%, #0e6577 100%);
    }

    /* ── Tarjetas de Estado y Resultados ── */
    .status-search-box {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }

    .status-result-card {
      background: linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%);
      border: 1.5px solid #ccfbf1;
      border-radius: 18px;
      padding: 1.75rem;
      box-shadow: 0 8px 24px rgba(15, 118, 110, 0.08);
      animation: fadeSlideUp 0.3s ease;
    }

    .status-row-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.6rem 0;
      border-bottom: 1px solid #edf2f7;
      font-size: 0.92rem;
    }

    .status-row-item:last-child {
      border-bottom: none;
    }

    .status-row-label {
      font-weight: 600;
      color: var(--ucc-muted);
    }

    .status-row-value {
      font-weight: 700;
      color: var(--ucc-text);
      text-align: right;
    }

    /* ── Sección de Consejos y Recursos ── */
    .tips-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
    }

    .tip-card {
      background: #fafbfc;
      border: 1px solid var(--ucc-border);
      border-radius: 16px;
      padding: 1.25rem;
      transition: transform 0.2s;
    }

    .tip-card:hover {
      transform: translateY(-3px);
      background: #ffffff;
      box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .tip-icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      display: inline-block;
    }

    .tip-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--ucc-primary-dark);
      margin-bottom: 0.35rem;
    }

    .tip-desc {
      font-size: 0.85rem;
      color: var(--ucc-muted);
      line-height: 1.5;
    }

    .emergency-hotline {
      background: #fff1f2;
      border: 1.5px solid #fecaca;
      border-radius: 16px;
      padding: 1.25rem;
      margin-top: 1.5rem;
    }

    .emergency-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #b91c1c;
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Footer */
    .portal-footer {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--ucc-muted);
      font-size: 0.82rem;
      border-top: 1px solid var(--ucc-border);
      background: #ffffff;
      margin-top: 3rem;
    }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <%# ── Barra de Navegación del Portal ── %>
  <nav class="portal-nav">
    <a href="/login" class="portal-logo-wrap" title="Acceso a la plataforma institucional ENLACE (Iniciar sesión)">
      <img src="/img/logolink.png" alt="ENLACE UCC" height="38" style="max-width:140px; object-fit:contain;">
      <div class="portal-brand-text">
        <span class="portal-brand-title">Portal Estudiantil</span>
        <span class="portal-brand-sub">Bienestar Universitario</span>
      </div>
    </a>
    <div class="portal-nav-badges">
      <span class="badge-confidential">
        🔒 Confidencial & Seguro
      </span>
      <span class="badge-qr-access">
        📲 Acceso QR Semestre 2026-2
      </span>
    </div>
  </nav>

  <main class="portal-container">

    <%# ── Hero de Bienvenida y Empatía ── %>
    <section class="portal-hero">
      <h1 class="portal-hero-title">¡Hola! Estamos aquí para escucharte y acompañarte</h1>
      <p class="portal-hero-desc">
        Tu salud emocional, adaptación universitaria y rendimiento académico son fundamentales. Nuestro equipo de psicólogos y asesores de ENLACE te brinda un espacio seguro, cercano y sin juicios.
      </p>
      <div class="portal-hero-strip">
        <span>⏰ Horario de atención: <strong>Lunes a Viernes de 2:00 PM a 4:00 PM</strong></span>
        <span>📍 Modalidades: <strong>Presencial (Bloque B) o Virtual (Meet)</strong></span>
        <span>🆓 Servicio institucional 100% gratuito</span>
      </div>
    </section>

    <%# ── Pestañas del Portal ── %>
    <nav class="portal-tabs-nav" aria-label="Secciones del portal">
      <button type="button" class="portal-tab-btn active" id="tab-btn-agendar" onclick="cambiarPestana('agendar', this)">
        <span>📅</span> Agendar Cita
      </button>
      <button type="button" class="portal-tab-btn" id="tab-btn-estado" onclick="cambiarPestana('estado', this)">
        <span>🔍</span> Consultar Estado
      </button>
      <button type="button" class="portal-tab-btn" id="tab-btn-reagendar" onclick="cambiarPestana('reagendar', this)">
        <span>🔄</span> Reagendar Cita
      </button>
      <button type="button" class="portal-tab-btn" id="tab-btn-consejos" onclick="cambiarPestana('consejos', this)">
        <span>💙</span> Bienestar & Ayuda
      </button>
    </nav>

    <%# ══════════════════════════════════════════════════════════════════════ %>
    <%# TAB 1: FORMULARIO PARA AGENDAR CITA                                  %>
    <%# ══════════════════════════════════════════════════════════════════════ %>
    <section id="tab-content-agendar" class="portal-card">
      <header class="portal-card-header">
        <span class="card-eyebrow">ACOMPAÑAMIENTO INTEGRAL</span>
        <h2 class="portal-card-title">Agenda tu cita de bienestar</h2>
        <p class="portal-card-subtitle">Completa tus datos para reservar tu franja de atención (2:00 PM – 4:00 PM).</p>
      </header>

      <form id="form-agendar-cita" onsubmit="enviarAgendamiento(event)">
        
        <%# Sección 1: Datos Personales e Institucionales %>
        <div class="form-section-title">
          <span>1.</span> Datos del estudiante
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="f-id" class="form-label-styled">ID Universitario (Código UCC) *</label>
            <input type="text" id="f-id" class="form-control form-control-styled" placeholder="Ej: 1002345678" required pattern="[0-9]{6,12}" title="Digita tu ID universitario numérico">
          </div>
          <div class="col-md-6">
            <label for="f-correo" class="form-label-styled">Correo institucional UCC *</label>
            <input type="email" id="f-correo" class="form-control form-control-styled" placeholder="nombre.apellido@campusucc.edu.co" required>
          </div>
          <div class="col-md-6">
            <label for="f-nombres" class="form-label-styled">Nombres completos *</label>
            <input type="text" id="f-nombres" class="form-control form-control-styled" placeholder="Ej: Carlos Alberto" required>
          </div>
          <div class="col-md-6">
            <label for="f-apellidos" class="form-label-styled">Apellidos completos *</label>
            <input type="text" id="f-apellidos" class="form-control form-control-styled" placeholder="Ej: Pérez Gómez" required>
          </div>
          <div class="col-md-6">
            <label for="f-telefono" class="form-label-styled">Teléfono / WhatsApp de contacto *</label>
            <input type="tel" id="f-telefono" class="form-control form-control-styled" placeholder="Ej: 3101234567" required pattern="[0-9]{10}">
          </div>
          <div class="col-md-4">
            <label for="f-carrera" class="form-label-styled">Carrera / Programa académico *</label>
            <select id="f-carrera" class="form-select form-select-styled" required>
              <option value="">Selecciona tu programa...</option>
              <option value="Psicología">Psicología</option>
              <option value="Ingeniería de Sistemas">Ingeniería de Sistemas</option>
              <option value="Medicina">Medicina</option>
              <option value="Derecho">Derecho</option>
              <option value="Contaduría Pública">Contaduría Pública</option>
              <option value="Administración de Empresas">Administración de Empresas</option>
              <option value="Enfermería">Enfermería</option>
              <option value="Odontología">Odontología</option>
              <option value="Medicina Veterinaria y Zootecnia">Medicina Veterinaria y Zootecnia</option>
              <option value="Comercio Internacional">Comercio Internacional</option>
              <option value="Ingeniería Civil">Ingeniería Civil</option>
              <option value="Comunicación Social">Comunicación Social</option>
            </select>
          </div>
          <div class="col-md-2">
            <label for="f-semestre" class="form-label-styled">Semestre *</label>
            <select id="f-semestre" class="form-select form-select-styled" required>
              <option value="">Nivel</option>
              <option value="1">1°</option><option value="2">2°</option>
              <option value="3">3°</option><option value="4">4°</option>
              <option value="5">5°</option><option value="6">6°</option>
              <option value="7">7°</option><option value="8">8°</option>
              <option value="9">9°</option><option value="10">10°</option>
            </select>
          </div>
        </div>

        <%# Sección 2: Selección de Psicólogo / Asesor %>
        <div class="form-section-title">
          <span>2.</span> Psicólogo o Asesor de Preferencia
        </div>
        <p class="text-muted small mb-2">Puedes seleccionar el profesional con quien te sientas más cómodo o pedir asignación automática:</p>

        <input type="hidden" id="f-psicologo" value="Asignación automática por disponibilidad">
        <div class="psychologist-grid">
          <div class="psychologist-card selected" onclick="seleccionarPsicologo(this, 'Asignación automática por disponibilidad')">
            <div class="psychologist-avatar">⚡</div>
            <div>
              <div class="psychologist-name">Asignación Automática</div>
              <div class="psychologist-specialty">Primer profesional disponible</div>
            </div>
          </div>
