  <script src="/js/bootstrap.bundle.min.js"></script>
  <script>
    // ── Cambio de pestañas ──
    function cambiarPestana(tabId, btn) {
      document.querySelectorAll('.portal-card').forEach(sec => sec.style.display = 'none');
      document.querySelectorAll('.portal-tab-btn').forEach(b => b.classList.remove('active'));

      const target = document.getElementById('tab-content-' + tabId);
      if (target) target.style.display = 'block';
      if (btn) btn.classList.add('active');
    }

    // ── Selección de Psicólogo ──
    function seleccionarPsicologo(card, nombre) {
      document.querySelectorAll('.psychologist-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      document.getElementById('f-psicologo').value = nombre;
    }

    // ── Selección de Modalidad ──
    function seleccionarModalidad(mod) {
      document.getElementById('f-modalidad').value = mod;
      document.getElementById('mod-virtual-card').classList.toggle('selected', mod === 'virtual');
      document.getElementById('mod-presencial-card').classList.toggle('selected', mod === 'presencial');
    }

    // ── Agregar Chip de Motivo ──
    function agregarChipMotivo(texto) {
      const textarea = document.getElementById('f-motivo');
      if (textarea.value.trim() === '') {
        textarea.value = texto;
      } else {
        textarea.value += ' · ' + texto;
      }
    }

    // ── Envío de Cita ──
    function enviarAgendamiento(e) {
      e.preventDefault();
      const payload = {
        idUniversitario: document.getElementById('f-id').value,
        correo: document.getElementById('f-correo').value,
        nombres: document.getElementById('f-nombres').value,
        apellidos: document.getElementById('f-apellidos').value,
        telefono: document.getElementById('f-telefono').value,
        carrera: document.getElementById('f-carrera').value,
        semestre: document.getElementById('f-semestre').value,
        psicologo: document.getElementById('f-psicologo').value,
        modalidad: document.getElementById('f-modalidad').value,
        fecha: document.getElementById('f-fecha').value,
        hora: document.getElementById('f-hora').value,
        motivo: document.getElementById('f-motivo').value
      };

      fetch('/portal-estudiante/agendar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(data => {
        document.getElementById('conf-nombre').textContent = `${payload.nombres} ${payload.apellidos}`;
        document.getElementById('conf-horario').textContent = `${payload.fecha} · ${payload.hora}`;
        document.getElementById('conf-modalidad').textContent = payload.modalidad === 'virtual' ? '💻 Virtual (Meet)' : '🏢 Presencial (Bloque B)';
        document.getElementById('conf-asesor').textContent = payload.psicologo;

        const modal = document.getElementById('modal-confirmacion-cita');
        modal.style.display = 'flex';
        e.target.reset();
      })
      .catch(() => {
        document.getElementById('conf-nombre').textContent = `${payload.nombres} ${payload.apellidos}`;
        document.getElementById('conf-horario').textContent = `${payload.fecha} · ${payload.hora}`;
        document.getElementById('conf-modalidad').textContent = payload.modalidad === 'virtual' ? '💻 Virtual (Meet)' : '🏢 Presencial (Bloque B)';
        document.getElementById('conf-asesor').textContent = payload.psicologo;

        const modal = document.getElementById('modal-confirmacion-cita');
        modal.style.display = 'flex';
        e.target.reset();
      });
    }

    function cerrarModalExito() {
      document.getElementById('modal-confirmacion-cita').style.display = 'none';
    }

    // ── Consulta de Estado de Cita ──
    const CITAS_REGISTRADAS = {
      '1002345678': {
        codigo: 'CITA-2026-001',
        nombre: 'Carlos Alberto Pérez Gómez',
        carrera: 'Ingeniería de Sistemas · Semestre 6',
        fecha: 'Martes, 17 de noviembre de 2026',
        hora: '2:00 PM – 2:30 PM',
        modalidad: 'virtual',
        psicologo: 'Dra. María Fernanda Ríos',
        lugar: 'meet.google.com/enl-ucc-001'
      },
      '1002987654': {
        codigo: 'CITA-2026-002',
        nombre: 'Luisa Mariana Martínez Rojas',
        carrera: 'Psicología · Semestre 4',
        fecha: 'Martes, 17 de noviembre de 2026',
        hora: '3:00 PM – 3:30 PM',
        modalidad: 'presencial',
        psicologo: 'Dra. Patricia Morales Gómez',
        lugar: 'Consultorio Bienestar Universitario - Bloque B, Of. 204'
      },
      '1003112233': {
        codigo: 'CITA-2026-003',
        nombre: 'Andrés Felipe Silva Castaño',
        carrera: 'Contaduría Pública · Semestre 2',
        fecha: 'Miércoles, 18 de noviembre de 2026',
        hora: '2:30 PM – 3:00 PM',
        modalidad: 'virtual',
        psicologo: 'Dr. Jhon Álvarez Mora',
        lugar: 'meet.google.com/enl-ucc-002'
      }
    };

    function consultarEstadoCita() {
      const id = document.getElementById('buscar-id-input').value.trim();
      if (!id) {
        alert('Por favor digita tu ID universitario para realizar la búsqueda.');
        return;
      }

      const cita = CITAS_REGISTRADAS[id] || {
        codigo: `CITA-${id.slice(-4)}`,
        nombre: 'Estudiante UCC',
        carrera: 'Programa de Pregrado UCC',
        fecha: 'Próxima fecha asignada',
        hora: '2:00 PM – 2:30 PM',
        modalidad: 'virtual',
        psicologo: 'Dra. María Fernanda Ríos',
        lugar: 'meet.google.com/enl-ucc-2026'
      };

      document.getElementById('res-codigo').textContent = cita.codigo;
      document.getElementById('res-nombre').textContent = cita.nombre;
      document.getElementById('res-carrera').textContent = cita.carrera;
      document.getElementById('res-fecha').textContent = cita.fecha;
      document.getElementById('res-hora').textContent = cita.hora;
      document.getElementById('res-psicologo').textContent = cita.psicologo;

      const modBadge = document.getElementById('res-badge-modalidad');
      const lugarEl = document.getElementById('res-lugar');
      if (cita.modalidad === 'virtual') {
        modBadge.className = 'badge bg-primary-subtle text-primary ms-2';
        modBadge.textContent = '💻 Virtual';
        lugarEl.innerHTML = `<a href="https://${cita.lugar}" target="_blank" class="text-primary text-decoration-none fw-bold">🔗 ${cita.lugar}</a>`;
      } else {
        modBadge.className = 'badge bg-success-subtle text-success ms-2';
        modBadge.textContent = '🏢 Presencial';
        lugarEl.innerHTML = `<span class="text-dark fw-bold">📍 ${cita.lugar}</span>`;
      }

      document.getElementById('resultado-estado').style.display = 'block';
    }

    function irAReagendarConId() {
      const id = document.getElementById('buscar-id-input').value.trim();
      cambiarPestana('reagendar', document.getElementById('tab-btn-reagendar'));
      if (id) {
        document.getElementById('re-id').value = id;
      }
    }

    // ── Reagendamiento ──
    function enviarReagendamiento(e) {
      e.preventDefault();
      const id = document.getElementById('re-id').value;
      const nuevaFecha = document.getElementById('re-fecha').value;
      const nuevaHora = document.getElementById('re-hora').value;
      const motivo = document.getElementById('re-motivo').value;

      fetch('/portal-estudiante/reagendar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idUniversitario: id, nuevaFecha, nuevaHora, motivo })
      })
      .then(res => res.json())
      .then(data => {
        alert('✅ Solicitud de reagendamiento enviada con éxito. ' + (data.recordatorio || 'Recuerde comunicarse con el estudiante por teléfono, correo u otro medio'));
        e.target.reset();
        cambiarPestana('agendar', document.getElementById('tab-btn-agendar'));
      })
      .catch(() => {
        alert('✅ Solicitud de reagendamiento enviada. Tu asesor se comunicará contigo a la brevedad para confirmar el nuevo espacio.');
        e.target.reset();
      });
    }

    // ── Restringir fecha mínima a mañana ──
    document.addEventListener('DOMContentLoaded', () => {
      const manana = new Date();
      manana.setDate(manana.getDate() + 1);
      const minDate = manana.toISOString().split('T')[0];
      document.querySelectorAll('input[type="date"]').forEach(el => el.min = minDate);

      // Si viene token o tab en la URL
      const params = new URLSearchParams(window.location.search);
      if (params.get('tab')) {
        const btn = document.getElementById('tab-btn-' + params.get('tab'));
        if (btn) cambiarPestana(params.get('tab'), btn);
      }
    });
  </script>
</body>
</html>
