<section class="container py-5">
  <div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <p class="eyebrow mb-1">Acompañamiento estudiantil</p>
      <h1 class="h2 fw-bold text-dark mb-1">Casos de estudiantes</h1>
      <p class="text-muted mb-0">Cada caso es una oportunidad para estar más cerca.</p>
    </div>
    <div class="d-flex align-items-center gap-3">
      <span class="count-pill shadow-sm" id="case-count"><strong><%= cases.length %></strong> <%= cases.length === 1 ? 'caso' : 'casos' %></span>
      <a class="btn btn-primary-action shadow-sm" href="/casos/nuevo">
        <span>➕</span> Registrar un caso
      </a>
    </div>
    <% if (created) { %>
      <div class="alert alert-success w-100 mt-3 rounded-4 shadow-sm" role="status">
        <span class="me-2">✅</span> El caso se registró correctamente.
      </div>
    <% } %>
  </div>

  <%# ── Barra de Búsqueda y Filtros ── %>
  <form class="filter-panel p-4 bg-white rounded-4 border shadow-sm mt-3" id="case-filters" action="/casos" method="get" role="search" aria-label="Buscar y filtrar casos">
    <div class="row g-3 align-items-end">
      <div class="col-md-5 filter-search">
        <label class="form-label small fw-bold text-muted text-uppercase" for="buscar">Buscar estudiante o identificador</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0">🔍</span>
          <input class="form-control border-start-0 ps-0" id="buscar" name="q" type="search" placeholder="Ej. Valentina o EN-2026-001" value="<%= filters.search %>">
        </div>
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-bold text-muted text-uppercase" for="estado">Estado del caso</label>
        <select class="form-select" id="estado" name="estado">
          <option value="">Todos los estados</option>
          <% Object.entries(statusLabels).forEach(([value, label]) => { %>
            <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-bold text-muted text-uppercase" for="programa">Programa</label>
        <select class="form-select" id="programa" name="carrera">
          <option value="">Todos los programas</option>
          <% programs.forEach((program) => { %>
            <option value="<%= program %>" <%= filters.program === program ? 'selected' : '' %>><%= program %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1 filter-actions d-flex gap-2">
        <noscript><button class="btn btn-primary-action w-100" type="submit">Buscar</button></noscript>
        <a class="btn btn-outline-secondary w-100 fw-bold" id="clear-filters" href="/casos" title="Limpiar filtros">Limpiar</a>
      </div>
    </div>
  </form>

  <p id="filter-loading" class="filter-loading mt-3 text-primary fw-bold" role="status" hidden>Actualizando casos…</p>
  <p id="filter-error" class="field-error" role="alert" hidden></p>
  <p class="visually-hidden" id="filter-announcement" aria-live="polite"></p>

  <div id="case-results" data-urgency-alta="<%= urgencyLabels.ALTA %>" data-urgency-media="<%= urgencyLabels.MEDIA %>" data-urgency-baja="<%= urgencyLabels.BAJA %>" data-status-registrado="<%= statusIcons.REGISTRADO %>" data-status-nuevo="<%= statusIcons.NUEVO %>" data-status-en_seguimiento="<%= statusIcons.EN_SEGUIMIENTO %>" data-status-en_espera="<%= statusIcons.EN_ESPERA %>" data-status-cerrado="<%= statusIcons.CERRADO %>">
  <% if (cases.length) { %>
    <div class="case-grid mt-4">
      <% cases.forEach((studentCase) => { %>
        <article class="case-card bg-white p-4 rounded-4 shadow-sm border">
          <div class="case-card-top d-flex justify-content-between align-items-center mb-3">
            <span class="case-id badge bg-light text-primary border fw-bold px-3 py-1 fs-6"><%= studentCase.id %></span>
            <span class="urgency-chip urgency-<%= studentCase.urgency.toLowerCase() %>">
              <span aria-hidden="true"><%= studentCase.urgency === 'ALTA' ? '!' : studentCase.urgency === 'MEDIA' ? '◷' : '✓' %></span>
              Urgencia <%= urgencyLabels[studentCase.urgency] %>
            </span>
          </div>

          <div class="d-flex align-items-center gap-3 mb-2">
            <div class="user-avatar-circle">
              <%= studentCase.studentName ? studentCase.studentName.charAt(0).toUpperCase() : 'E' %>
            </div>
            <div>
              <h2 class="h5 fw-bold mb-0">
                <a href="/casos/<%= encodeURIComponent(studentCase.id) %>" class="text-decoration-none text-dark hover-primary">
                  <%= studentCase.studentName %>
                </a>
              </h2>
              <span class="case-program text-muted small"><%= studentCase.program %></span>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 my-2">
            <span class="status-chip status-<%= studentCase.status.toLowerCase() %>">
              <span aria-hidden="true"><%= statusIcons[studentCase.status] %></span>
              <%= statusLabels[studentCase.status] %>
            </span>
            <% if (studentCase.tieneCorreoInstitucional === false) { %>
              <span class="contact-status-chip badge bg-warning-subtle text-dark border">Sin correo institucional</span>
            <% } %>
          </div>

          <% if (!studentCase.markers?.length) { %>
            <p class="neutral-case-note text-muted small mb-2 fst-italic">Sin marcadores registrados</p>
          <% } else { %>
            <div class="d-flex flex-wrap gap-1 mb-2">
              <% studentCase.markers.slice(0, 3).forEach(m => { %>
                <span class="badge bg-secondary-subtle text-secondary small" style="font-size:0.72rem;">🏷️ <%= m %></span>
              <% }) %>
            </div>
          <% } %>

          <p class="case-summary text-secondary small mb-3 text-truncate-2">
            <%= studentCase.summary %>
          </p>

          <div class="case-card-footer pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
            <span>Último movimiento:</span>
            <time datetime="<%= studentCase.lastMovement %>" class="fw-semibold"><%= formatDate(studentCase.lastMovement) %></time>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <section class="empty-state mt-4 p-5 bg-white text-center rounded-4 border shadow-sm" aria-labelledby="empty-title">
      <span class="empty-mark" aria-hidden="true" style="font-size:3rem; display:block; margin-bottom:1rem;">⌕</span>
      <h2 id="empty-title" class="h4 fw-bold">No encontramos casos con esos filtros</h2>
      <p class="text-muted max-w-md mx-auto">Prueba con otro nombre, identificador o estado. Si buscabas empezar de nuevo, puedes ver todos los casos.</p>
      <a class="btn btn-primary-action mt-2" href="/casos">Ver todos los casos</a>
    </section>
  <% } %>
  </div>
  <script src="/js/case-filters.js" defer></script>
</section>
