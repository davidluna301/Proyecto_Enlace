<section class="container py-5 detail-container">
  <div class="mb-3">
    <a class="back-link" href="/casos">
      <span>←</span> Volver a los casos
    </a>
  </div>

  <div class="detail-card case-elevated-card p-4 p-md-5">
    <div class="case-hero-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <p class="eyebrow">Acompañamiento estudiantil</p>
          <h1 class="h2 fw-bold text-dark mb-1">Registrar un caso</h1>
          <p class="text-muted mb-0">Comparte la información necesaria para iniciar el acompañamiento.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
          📋 Formulario Oficial ENLACE UCC
        </span>
      </div>
    </div>

    <% if (Object.keys(errors).length) { %>
      <div class="alert alert-danger mb-4 rounded-4" role="alert" aria-labelledby="form-errors-title">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span style="font-size:1.2rem;">⚠️</span>
          <h2 class="h6 mb-0 fw-bold" id="form-errors-title">Revisa los campos indicados antes de continuar.</h2>
        </div>
        <ul class="mb-0 ps-3">
          <% Object.entries(errors).forEach(([field, message]) => { %>
            <li><a href="#<%= field === 'markers' ? 'markers-toggle' : field %>" class="text-danger fw-semibold"><%= message %></a></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/casos" method="post" id="case-create-form" novalidate>
      
      <%# ── SECCIÓN 1: DATOS DEL ESTUDIANTE ── %>
      <div class="case-section-box">
        <h2 class="h4 case-section-title">
          <span class="step-num-pill">1</span>
          Datos del estudiante
        </h2>

        <div class="mb-3">
          <label class="form-label fw-bold" for="studentName">Nombre del estudiante *</label>
          <input 
            class="form-control form-control-lg form-input-styled <%= errors.studentName ? 'is-invalid' : '' %>" 
            id="studentName" 
            name="studentName" 
            placeholder="Ej: Valentina Gómez Morales"
            value="<%= values.studentName %>" 
            minlength="3" 
            maxlength="100" 
            required 
            aria-describedby="studentName-error" 
            <%= errors.studentName ? 'aria-invalid="true"' : '' %>
          >
          <div class="field-error" id="studentName-error" role="alert"><%= errors.studentName || '' %></div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold" for="email">Correo institucional *</label>
          <div class="d-flex flex-column flex-md-row gap-2">
            <input 
              class="form-control form-control-lg form-input-styled <%= errors.email ? 'is-invalid' : '' %>" 
              id="email" 
              name="email" 
              type="email" 
              placeholder="nombre.apellido@campusucc.edu.co"
              value="<%= values.email %>" 
              <%= values.tieneCorreoInstitucional ? 'required' : 'disabled' %> 
              aria-describedby="email-help email-error" 
              data-domain="<%= emailDomain %>" 
              <%= errors.email ? 'aria-invalid="true"' : '' %>
            >
            <div class="form-check form-switch align-self-md-center ps-md-4 py-2">
              <input 
                class="form-check-input" 
                id="sinCorreoInstitucional" 
                name="sinCorreoInstitucional" 
                type="checkbox" 
                role="switch" 
                <%= values.tieneCorreoInstitucional ? '' : 'checked' %> 
                aria-controls="contact-alternative"
              >
              <label class="form-check-label small fw-semibold text-secondary" for="sinCorreoInstitucional">
                No tiene / no accede al correo institucional
              </label>
            </div>
          </div>
          <div class="form-text" id="email-help">Debe terminar en @<%= emailDomain %>.</div>
          <div class="field-error" id="email-error" role="alert"><%= errors.email || '' %></div>
          <p class="form-text mt-1 mb-0 text-warning fw-semibold" id="email-state" aria-live="polite">
            <%= values.tieneCorreoInstitucional ? '' : 'El caso se registrará sin correo institucional.' %>
          </p>

          <div id="contact-alternative" class="mt-3 p-3 bg-white rounded-3 border" <%= values.tieneCorreoInstitucional ? 'hidden' : '' %>>
            <label class="form-label fw-bold" for="contactEmail">Correo de contacto alternativo <span class="text-muted fw-normal">(opcional)</span></label>
            <input 
              class="form-control form-input-styled <%= errors.contactEmail ? 'is-invalid' : '' %>" 
              id="contactEmail" 
              name="contactEmail" 
              type="email" 
              placeholder="ejemplo@gmail.com"
              value="<%= values.contactEmail %>" 
              <%= values.tieneCorreoInstitucional ? 'disabled' : '' %> 
              aria-describedby="contactEmail-error" 
              <%= errors.contactEmail ? 'aria-invalid="true"' : '' %>
            >
            <div class="field-error" id="contactEmail-error" role="alert"><%= errors.contactEmail || '' %></div>
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label fw-bold" for="program">Carrera / Programa académico *</label>
          <select 
            class="form-select form-select-lg form-input-styled <%= errors.program ? 'is-invalid' : '' %>" 
            id="program" 
            name="program" 
            required 
            aria-describedby="program-error" 
            <%= errors.program ? 'aria-invalid="true"' : '' %>
          >
            <option value="">Selecciona un programa</option>
            <% programs.forEach((program) => { %>
              <option value="<%= program %>" <%= values.program === program ? 'selected' : '' %>><%= program %></option>
            <% }) %>
          </select>
          <div class="field-error" id="program-error" role="alert"><%= errors.program || '' %></div>
        </div>
      </div>

      <%# ── SECCIÓN 2: MOTIVO Y DICTADO POR VOZ ── %>
      <div class="case-section-box">
        <h2 class="h4 case-section-title">
          <span class="step-num-pill">2</span>
          Motivo
        </h2>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
            <label class="form-label fw-bold mb-0" for="summary">Descripción *</label>
            <%# Botón de Dictado por Voz (Requisito 14) %>
            <div class="voice-mic-container mb-0">
              <button type="button" class="voice-mic-btn" id="btn-voice-dictation" onclick="toggleVoiceDictation()" title="Haz clic para activar el micrófono y dictar el caso">
                <span id="mic-icon">🎙️</span>
                <span id="mic-label">Dictar por voz</span>
                <span class="voice-status-indicator" id="voice-indicator">● Escuchando...</span>
              </button>
            </div>
          </div>
          <textarea 
            class="form-control form-input-styled <%= errors.summary ? 'is-invalid' : '' %>" 
            id="summary" 
            name="summary" 
            rows="5" 
            minlength="20" 
            maxlength="1000" 
            required 
            placeholder="Describe detalladamente la situación académica o personal que motiva este acompañamiento..."
            aria-describedby="summary-count summary-error" 
            <%= errors.summary ? 'aria-invalid="true"' : '' %>
          ><%= values.summary %></textarea>
          <div class="d-flex justify-content-between align-items-center mt-1">
            <small class="text-muted">Mínimo 20 caracteres para un registro adecuado.</small>
            <div class="form-text fw-bold" id="summary-count"><%= values.summary.length %> / 1000 caracteres</div>
          </div>
          <div class="field-error" id="summary-error" role="alert"><%= errors.summary || '' %></div>
        </div>

        <div class="mb-2">
          <label class="form-label fw-bold" for="observacionesAsesor">
            Observaciones del asesor <span class="text-muted fw-normal">(opcional)</span>
          </label>
          <textarea 
            class="form-control form-input-styled <%= errors.observacionesAsesor ? 'is-invalid' : '' %>" 
            id="observacionesAsesor" 
            name="observacionesAsesor" 
            rows="3" 
            maxlength="500" 
            aria-describedby="observacionesAsesor-count observacionesAsesor-error" 
            placeholder="Notas adicionales, contexto relevante o acuerdos con el estudiante…" 
            <%= errors.observacionesAsesor ? 'aria-invalid="true"' : '' %>
          ><%= values.observacionesAsesor %></textarea>
          <div class="d-flex justify-content-end mt-1">
            <div class="form-text fw-bold" id="observacionesAsesor-count"><%= values.observacionesAsesor.length %> / 500 caracteres</div>
          </div>
          <div class="field-error" id="observacionesAsesor-error" role="alert"><%= errors.observacionesAsesor || '' %></div>
        </div>
      </div>

      <%# ── SECCIÓN 3: MARCADORES CRÍTICOS ── %>
      <section class="marker-selection case-section-box mt-4" aria-labelledby="markers-title">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
          <div class="form-check form-switch mb-0">
            <input 
              class="form-check-input" 
              id="markers-toggle" 
              name="includeMarkers" 
              type="checkbox" 
              role="switch" 
              <%= values.includeMarkers ? 'checked' : '' %> 
              aria-controls="markers-panel" 
              aria-expanded="<%= values.includeMarkers ? 'true' : 'false' %>"
            >
            <label class="form-check-label fw-bold text-dark fs-6" for="markers-toggle">
              Añadir marcadores críticos
            </label>
          </div>
          <div class="d-flex align-items-center gap-1">
            <span class="badge bg-light text-muted border">Escala:</span>
            <span title="Estable / Bajo">😊</span>
            <span title="Moderado">😐</span>
            <span title="Medio-Alto">😟</span>
            <span title="Alto">😰</span>
            <span title="Crítico">💀</span>
          </div>
        </div>
        <p class="text-muted mb-3 small">Son señales para orientar el acompañamiento, no diagnósticos.</p>

        <div id="markers-panel" <%= values.includeMarkers ? '' : 'hidden' %> class="p-3 bg-white rounded-3 border">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mt-0 mb-0" id="markers-title">Marcadores críticos</h2>
            <span class="badge bg-warning-subtle text-dark border">Prioridad Institucional</span>
          </div>
          <div class="field-error" id="markers-error" role="alert"><%= errors.markers || '' %></div>

          <div class="row g-3">
            <% groups.forEach((group) => { %>
              <div class="col-md-6">
                <fieldset class="marker-group p-3 border rounded-3 bg-light h-100">
                  <legend class="h6 fw-bold text-primary mb-2"><%= group.nombre %></legend>
                  <% group.marcadores.forEach((marker) => { %>
                    <div class="form-check mb-2">
                      <input 
                        class="form-check-input marker-checkbox" 
                        type="checkbox" 
                        name="markers" 
                        id="marker-<%= marker.id %>" 
                        value="<%= marker.id %>" 
                        <%= values.markers.includes(marker.id) ? 'checked' : '' %> 
                        aria-describedby="help-<%= marker.id %> markers-error"
                      >
                      <label class="form-check-label fw-semibold" for="marker-<%= marker.id %>">
                        <%= marker.nombre %>
                      </label>
                      <div class="form-text small text-muted" id="help-<%= marker.id %>"><%= marker.descripcion %></div>
                    </div>
                  <% }) %>
                </fieldset>
              </div>
            <% }) %>
          </div>
        </div>
      </section>

      <div class="d-flex flex-wrap gap-3 mt-4 pt-2">
        <button class="btn btn-primary-action btn-lg px-4" type="submit">
          <span>💾</span> Guardar caso
        </button>
        <a class="btn btn-filter-clear btn-lg px-4" href="/casos">
          Cancelar
        </a>
      </div>
    </form>
  </div>

  <script src="/js/case-form.js" defer></script>
  <script>
    // Asistente de Dictado por Voz (Speech-to-Text en tiempo real)
    let recognition = null;
    let isListening = false;

    function toggleVoiceDictation() {
      const btn = document.getElementById('btn-voice-dictation');
      const indicator = document.getElementById('voice-indicator');
      const micIcon = document.getElementById('mic-icon');
      const micLabel = document.getElementById('mic-label');
      const textarea = document.getElementById('summary');
      const countEl = document.getElementById('summary-count');

      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        alert('El reconocimiento de voz no está soportado en este navegador. Te sugerimos usar Google Chrome o Microsoft Edge.');
        return;
      }

      if (!recognition) {
        recognition = new SpeechRecognition();
        recognition.lang = 'es-CO';
        recognition.continuous = true;
        recognition.interimResults = true;

        recognition.onresult = (event) => {
          let transcript = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            transcript += event.results[i][0].transcript;
          }
          if (transcript.trim()) {
            if (textarea.value && !textarea.value.endsWith(' ')) {
              textarea.value += ' ';
            }
            textarea.value += transcript;
            if (countEl) {
              countEl.textContent = textarea.value.length + ' / 1000 caracteres';
            }
          }
        };

        recognition.onerror = (event) => {
          console.warn('SpeechRecognition error:', event.error);
          stopListening();
        };

        recognition.onend = () => {
          if (isListening) stopListening();
        };
      }

      if (!isListening) {
        try {
          recognition.start();
          isListening = true;
          btn.classList.add('listening');
          indicator.classList.add('active');
          micIcon.textContent = '⏹️';
          micLabel.textContent = 'Detener dictado';
        } catch (err) {
          console.error(err);
        }
      } else {
        stopListening();
      }

      function stopListening() {
        if (recognition) {
          try { recognition.stop(); } catch(e){}
        }
        isListening = false;
        btn.classList.remove('listening');
        indicator.classList.remove('active');
        micIcon.textContent = '🎙️';
        micLabel.textContent = 'Dictar por voz';
      }
    }
  </script>
</section>
