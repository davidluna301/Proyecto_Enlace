<%# views/calendario/index.ejs – Calendario mensual de citas ENLACE UCC %>
<div class="dashboard-wrapper">

  <%# ── Header Principal ── %>
  <div class="cal-top-header">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">📅 AGENDA INSTITUCIONAL</span>
        <span class="badge bg-success-subtle text-success fw-semibold px-2 py-1">⏰ 2:00 PM – 4:00 PM</span>
      </div>
      <h1 class="cal-page-title">Calendario de Citas y Acompañamiento</h1>
      <p class="cal-page-subtitle">
        Gestión de citas de bienestar universitario para estudiantes UCC. Franja oficial de atención: lunes a viernes, 2:00 PM a 4:00 PM.
      </p>
    </div>
    <div class="cal-header-buttons">
      <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="irAHoy()">
        📍 Hoy
      </button>
      <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" onclick="abrirModalEvento()">
        ➕ Agregar evento / Cambiar horario
      </button>
    </div>
  </div>

  <%# ── Barra de Navegación del Mes y Filtros ── %>
  <div class="cal-toolbar-card">
    <div class="cal-nav-controls">
      <button class="btn-cal-arrow" onclick="cambiarMes(-1)" title="Mes anterior" aria-label="Mes anterior">
        ◀
      </button>
      <h2 id="cal-titulo-mes" class="cal-month-heading">Noviembre 2026</h2>
      <button class="btn-cal-arrow" onclick="cambiarMes(1)" title="Mes siguiente" aria-label="Mes siguiente">
        ▶
      </button>
    </div>

    <%# Filtro de Modalidad %>
    <div class="cal-filter-group">
      <span class="cal-filter-label">Filtrar:</span>
      <div class="btn-group btn-group-sm" role="group" aria-label="Filtro de citas">
        <button type="button" class="btn btn-outline-primary active" id="btn-filtro-todas" onclick="filtrarCitas('todas', this)">Todas</button>
        <button type="button" class="btn btn-outline-primary" id="btn-filtro-virtual" onclick="filtrarCitas('virtual', this)">💻 Virtual</button>
        <button type="button" class="btn btn-outline-primary" id="btn-filtro-presencial" onclick="filtrarCitas('presencial', this)">🏢 Presencial</button>
      </div>
    </div>

    <%# Leyenda gráfica %>
    <div class="cal-legend-pills">
      <span class="legend-badge legend-virtual">
        <span class="legend-dot dot-virtual"></span> Virtual (2PM-4PM)
      </span>
      <span class="legend-badge legend-presencial">
        <span class="legend-dot dot-presencial"></span> Presencial (2PM-4PM)
      </span>
      <span class="legend-badge legend-festivo">
        <span class="legend-dot dot-festivo"></span> Festivo Colombia
      </span>
      <span class="legend-badge legend-evento">
        <span class="legend-dot dot-evento"></span> Novedad / Evento
      </span>
    </div>
  </div>

  <%# ── Contenedor Grilla y Panel Lateral ── %>
  <div class="cal-layout-grid">

    <%# Grilla del Calendario %>
    <div class="cal-calendar-card">
      <div class="cal-grid" id="calendar-grid">
        <!-- Renderizado dinámico vía JavaScript -->
      </div>
    </div>

    <%# Panel Lateral del Día Seleccionado %>
    <aside class="cal-side-card" id="side-panel" aria-label="Citas del día seleccionado">
      <div class="side-panel-header">
        <div>
          <span class="side-panel-eyebrow">AGENDA DEL DÍA</span>
          <h3 id="side-panel-date" class="side-panel-date">Martes, 17 de noviembre</h3>
        </div>
        <span id="side-panel-count-badge" class="badge bg-primary rounded-pill">2 citas</span>
      </div>

      <%# Alerta de festivo si aplica %>
      <div id="side-festivo-alert" class="alert-festivo-banner" style="display:none;">
        <span class="festivo-flag">🇨🇴</span>
        <div>
          <strong id="side-festivo-nombre">Festivo Nacional</strong>
