// ── Estado global del calendario ──
let currentYear = 2026;
let currentMonth = 10; // 0-indexed: 10 = Noviembre
let diaSeleccionadoKey = '2026-11-17';
let filtroModalidad = 'todas';
let citaActivaModal = null;

const meses = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
];
const diasSemana = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

function pad(n) { return String(n).padStart(2, '0'); }
function dateKey(y, m, d) { return `${y}-${pad(m + 1)}-${pad(d)}`; }

// ── Renderizado del Calendario Mensual ──
function renderCalendar() {
  const titulo = document.getElementById('cal-titulo-mes');
  titulo.textContent = `${meses[currentMonth]} ${currentYear}`;

  const grid = document.getElementById('calendar-grid');
  // Primer día del mes (ajustado para que Lunes sea 0 y Domingo 6)
  const primerDiaRaw = new Date(currentYear, currentMonth, 1).getDay();
  const primerDiaLunes = (primerDiaRaw + 6) % 7;
  const diasEnMes = new Date(currentYear, currentMonth + 1, 0).getDate();
  const diasMesAnterior = new Date(currentYear, currentMonth, 0).getDate();

  const hoy = new Date();
  const hoyKey = `${hoy.getFullYear()}-${pad(hoy.getMonth() + 1)}-${pad(hoy.getDate())}`;

  let html = '<div class="cal-days-header-row">';
  diasSemana.forEach(d => {
    html += `<div class="cal-day-heading">${d}</div>`;
  });
  html += '</div>';

  html += '<div class="cal-cells-grid">';

  // Celdas del mes anterior (relleno)
  for (let i = primerDiaLunes - 1; i >= 0; i--) {
    const num = diasMesAnterior - i;
    html += `<div class="cal-cell cal-cell--prev-month"><span class="cal-cell-num text-muted opacity-50">${num}</span></div>`;
  }

  // Celdas del mes actual
  for (let d = 1; d <= diasEnMes; d++) {
    const key = dateKey(currentYear, currentMonth, d);
    const todasCitas = citasDb[key] || [];
    const festivo = festivosColombia[key];

    // Filtrar citas según filtro activo
    const citasVisibles = todasCitas.filter(c => {
      if (filtroModalidad === 'todas') return true;
      return c.modalidad === filtroModalidad;
    });

    let cls = 'cal-cell';
    if (festivo) cls += ' cal-cell--festivo';
    if (key === hoyKey) cls += ' cal-cell--today';
    if (key === diaSeleccionadoKey) cls += ' cal-cell--selected';

    const fechaObj = new Date(currentYear, currentMonth, d);
    const esFinDeSemana = (fechaObj.getDay() === 0 || fechaObj.getDay() === 6);
    if (esFinDeSemana) cls += ' cal-cell--weekend';

    let pillsHtml = '';
    citasVisibles.slice(0, 3).forEach((c, idx) => {
      const icono = c.modalidad === 'virtual' ? '💻' : '🏢';
      const primerNombre = c.nombre.split(' ')[0];
      pillsHtml += `
        <div class="cal-cita-pill cal-cita-pill--${c.modalidad}" 
             onclick="abrirModalDetalleCita(event, '${key}', '${c.id}')"
             title="${c.hora} - ${c.nombre} (${c.modalidad})">
          <span class="pill-dot"></span>
          <span class="pill-time">${c.hora}</span>
          <span class="pill-name">${primerNombre}</span>
        </div>`;
    });

    if (citasVisibles.length > 3) {
      pillsHtml += `<div class="cal-more-pills">+${citasVisibles.length - 3} más</div>`;
    }

    html += `
      <div class="${cls}" onclick="seleccionarDia('${key}', ${d})" data-key="${key}">
        <div class="cal-cell-header">
          <span class="cal-cell-num">${d}</span>
          ${key === hoyKey ? '<span class="cal-today-badge">HOY</span>' : ''}
          ${festivo ? '<span class="cal-festivo-badge">🇨🇴 FESTIVO</span>' : ''}
        </div>
        ${festivo ? `<div class="cal-festivo-label" title="${festivo}">${festivo}</div>` : ''}
        <div class="cal-cell-pills">${pillsHtml}</div>
      </div>`;
  }

  // Celdas del mes siguiente para completar la grilla
  const celdasTotales = primerDiaLunes + diasEnMes;
  const celdasRestantes = (7 - (celdasTotales % 7)) % 7;
  for (let j = 1; j <= celdasRestantes; j++) {
    html += `<div class="cal-cell cal-cell--next-month"><span class="cal-cell-num text-muted opacity-50">${j}</span></div>`;
  }

  html += '</div>';
  grid.innerHTML = html;

  // Actualizar el panel lateral con la selección actual
  actualizarSidePanel(diaSeleccionadoKey);
}

// ── Selección de un día ──
function seleccionarDia(key, d) {
  diaSeleccionadoKey = key;
  document.querySelectorAll('.cal-cell').forEach(c => c.classList.remove('cal-cell--selected'));
  const celda = document.querySelector(`[data-key="${key}"]`);
  if (celda) celda.classList.add('cal-cell--selected');

  actualizarSidePanel(key);
}

// ── Actualización del panel lateral ──
function actualizarSidePanel(key) {
  const [y, m, d] = key.split('-').map(Number);
  const fechaObj = new Date(y, m - 1, d);
  const nombreDia = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'][fechaObj.getDay()];
  const nombreMes = meses[m - 1];

  const dateHeading = document.getElementById('side-panel-date');
  dateHeading.textContent = `${nombreDia}, ${d} de ${nombreMes} ${y}`;

  const festivo = festivosColombia[key];
  const festivoBanner = document.getElementById('side-festivo-alert');
  const festivoNombre = document.getElementById('side-festivo-nombre');
  if (festivo) {
    festivoBanner.style.display = 'flex';
    festivoNombre.textContent = `Festivo: ${festivo}`;
  } else {
    festivoBanner.style.display = 'none';
  }

  const todasCitas = citasDb[key] || [];
  const citasFiltradas = todasCitas.filter(c => {
    if (filtroModalidad === 'todas') return true;
    return c.modalidad === filtroModalidad;
  });

  const countBadge = document.getElementById('side-panel-count-badge');
  countBadge.textContent = `${citasFiltradas.length} ${citasFiltradas.length === 1 ? 'cita' : 'citas'}`;

  const listContainer = document.getElementById('side-panel-appointments');
  if (citasFiltradas.length === 0) {
    listContainer.innerHTML = `
      <div class="empty-state-side py-4 text-center">
        <span class="empty-icon d-block mb-2">🌿</span>
        <h5 class="fw-bold mb-1">Sin citas programadas</h5>
        <p class="text-muted small mb-3">No hay citas en este día para el filtro actual.</p>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="abrirModalEventoConFecha('${key}')">
          ➕ Agendar evento aquí
        </button>
      </div>`;
  } else {
    listContainer.innerHTML = citasFiltradas.map(c => `
      <div class="side-cita-card side-cita-card--${c.modalidad}" onclick="abrirModalDetalleCita(event, '${key}', '${c.id}')">
        <div class="d-flex justify-content-between align-items-start mb-1">
          <span class="side-cita-time">⏰ ${c.hora} – ${c.horaFin || '2:30 PM'}</span>
          <span class="badge ${c.modalidad === 'virtual' ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success'} rounded-pill">
            ${c.modalidad === 'virtual' ? '💻 Virtual' : '🏢 Presencial'}
          </span>
        </div>
        <div class="side-cita-name">${c.nombre}</div>
        <div class="side-cita-sub">${c.carrera} · Semestre ${c.semestre}</div>
        <div class="side-cita-motivo text-truncate mt-1">📝 ${c.motivo}</div>
        <div class="side-cita-advisor mt-2 small text-muted">
          🧑‍💼 <strong>${c.psicologo}</strong>
        </div>
      </div>
    `).join('');
  }

  // Actualizar franjas horarias 2PM-4PM
  actualizarFranjasHorarias(key, todasCitas);
}

// ── Resumen de franjas de 2:00 PM a 4:00 PM ──
function actualizarFranjasHorarias(key, citas) {
  const franjas = ['2:00 PM', '2:30 PM', '3:00 PM', '3:30 PM'];
  const grid = document.getElementById('side-slots-grid');
  
  grid.innerHTML = franjas.map(hora => {
    const ocupada = citas.find(c => c.hora === hora);
    if (ocupada) {
      return `
        <div class="slot-item slot-item--booked" onclick="abrirModalDetalleCita(event, '${key}', '${ocupada.id}')" title="Ocupada por ${ocupada.nombre}">
          <span class="slot-time">${hora}</span>
          <span class="slot-status">Ocupada</span>
        </div>`;
    } else {
      return `
        <div class="slot-item slot-item--free" onclick="abrirModalEventoConFechaHora('${key}', '${hora}')" title="Disponible">
          <span class="slot-time">${hora}</span>
          <span class="slot-status">Disponible</span>
        </div>`;
    }
  }).join('');
}

// ── Filtro de modalidad ──
function filtrarCitas(modalidad, btn) {
  filtroModalidad = modalidad;
  document.querySelectorAll('.cal-filter-group .btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderCalendar();
}

// ── Navegación del mes ──
function cambiarMes(dir) {
  currentMonth += dir;
  if (currentMonth > 11) {
    currentMonth = 0;
    currentYear++;
  } else if (currentMonth < 0) {
    currentMonth = 11;
    currentYear--;
  }
  // Al cambiar mes, seleccionar el día 1
  diaSeleccionadoKey = dateKey(currentYear, currentMonth, 1);
  renderCalendar();
}

function irAHoy() {
  const hoy = new Date();
  currentYear = hoy.getFullYear();
  currentMonth = hoy.getMonth();
  diaSeleccionadoKey = `${hoy.getFullYear()}-${pad(hoy.getMonth() + 1)}-${pad(hoy.getDate())}`;
  renderCalendar();
}

// ── Modal Detalle de Cita ──
function abrirModalDetalleCita(e, key, citaId) {
  if (e) e.stopPropagation();
  const citas = citasDb[key] || [];
  const cita = citas.find(c => c.id === citaId) || citas[0];
  if (!cita) return;

  citaActivaModal = { ...cita, key };

  document.getElementById('modal-cita-titulo').textContent = `Cita: ${cita.nombre}`;
  document.getElementById('modal-cita-codigo').textContent = cita.id || 'CITA-UCC';
  document.getElementById('modal-cita-nombre').textContent = cita.nombre;
  document.getElementById('modal-cita-id').textContent = cita.estudianteId || 'N/A';
  document.getElementById('modal-cita-carrera').textContent = `${cita.carrera} · Semestre ${cita.semestre}`;
  document.getElementById('modal-cita-hora').textContent = `⏰ ${cita.hora} – ${cita.horaFin || '2:30 PM'}`;
  document.getElementById('modal-cita-psicologo').textContent = cita.psicologo || 'Dra. María Fernanda Ríos';
  document.getElementById('modal-cita-motivo').textContent = cita.motivo || 'Orientación y acompañamiento general.';

  // Correo y Teléfono
  const correoEl = document.getElementById('modal-cita-correo');
  correoEl.textContent = cita.correo || 'estudiante@campusucc.edu.co';
  correoEl.href = `mailto:${cita.correo}`;

  const telEl = document.getElementById('modal-cita-telefono');
  telEl.textContent = cita.telefono || '3001234567';
  telEl.href = `tel:${cita.telefono}`;

  // Avatar iniciales
  const iniciales = cita.nombre.split(' ').map(p => p[0]).slice(0, 2).join('');
  document.getElementById('modal-cita-avatar').textContent = iniciales;

  // Estado y Modalidad
  const estadoBadge = document.getElementById('modal-cita-estado-badge');
  estadoBadge.className = 'badge bg-success';
  estadoBadge.textContent = (cita.estado || 'Confirmada').toUpperCase();

  const modBadge = document.getElementById('modal-cita-modalidad-badge');
  const modIcon = document.getElementById('modal-cita-mod-icon');
  const lugarLabel = document.getElementById('modal-cita-lugar-label');
  const lugarContent = document.getElementById('modal-cita-lugar-content');

  if (cita.modalidad === 'virtual') {
    modBadge.className = 'badge bg-primary';
    modBadge.textContent = '💻 Virtual';
    modIcon.textContent = '💻';
    lugarLabel.textContent = 'Enlace de videollamada:';
    lugarContent.innerHTML = `
      <a href="${cita.enlaceMeet || 'https://meet.google.com/enl-ucc-001'}" target="_blank" rel="noopener" class="link-primary fw-semibold">
        🔗 ${cita.enlaceMeet || 'meet.google.com/enl-ucc-001'}
      </a>`;
  } else {
    modBadge.className = 'badge bg-success';
    modBadge.textContent = '🏢 Presencial';
    modIcon.textContent = '🏢';
    lugarLabel.textContent = 'Lugar de atención:';
    lugarContent.innerHTML = `
      <span class="text-dark fw-semibold">
        📍 ${cita.lugar || 'Consultorio Bienestar Universitario - Bloque B, Oficina 204'}
      </span>`;
  }

  document.getElementById('modal-detalle-cita').style.display = 'flex';
}

function cerrarModalDetalle() {
  document.getElementById('modal-detalle-cita').style.display = 'none';
  citaActivaModal = null;
}

function marcarCitaAtendida() {
  if (!citaActivaModal) return;
  mostrarToast(`✅ Cita de ${citaActivaModal.nombre} marcada como atendida exitosamente.`);
  cerrarModalDetalle();
}

function prepararReagendarDesdeCita() {
  if (!citaActivaModal) return;
  const nombreEstudiante = citaActivaModal.nombre;
  cerrarModalDetalle();
  abrirModalEvento();
  
  document.getElementById('ev-tipo').value = 'cambio-horario';
  document.getElementById('ev-fecha').value = citaActivaModal.key;
  document.getElementById('ev-desc').value = `Reagendamiento para el estudiante ${nombreEstudiante}. Horario solicitado previo: ${citaActivaModal.hora}.`;
  
  const alerta = document.getElementById('alerta-reagenda-box');
  alerta.style.display = 'block';
}

// ── Modal Agregar Evento / Cambiar Horario ──
function abrirModalEvento() {
  document.getElementById('ev-fecha').value = diaSeleccionadoKey;
  document.getElementById('modal-evento').style.display = 'flex';
}

function abrirModalEventoConFecha(key) {
  diaSeleccionadoKey = key;
  abrirModalEvento();
}

function abrirModalEventoConFechaHora(key, hora) {
  diaSeleccionadoKey = key;
  abrirModalEvento();
  document.getElementById('ev-franja').value = hora;
}

function cerrarModalEvento() {
  document.getElementById('modal-evento').style.display = 'none';
}

function onTipoEventoChange(tipo) {
  const alerta = document.getElementById('alerta-reagenda-box');
  // Mostrar siempre prominente o cuando sea cambio de horario/bloqueo
  if (tipo === 'cambio-horario' || tipo === 'no-disponible') {
    alerta.style.display = 'block';
  } else {
    alerta.style.display = 'block'; // Mandatorio en ENLACE
  }
}

function guardarEvento(e) {
  e.preventDefault();
  const tipo = document.getElementById('ev-tipo').value;
  const fecha = document.getElementById('ev-fecha').value;
  const franja = document.getElementById('ev-franja').value;
  const desc = document.getElementById('ev-desc').value;

  // Enviar a la API modular de calendario
  fetch('/calendario/api/evento', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tipo, fecha, descripcion: desc, franjaAfectada: franja })
  })
  .then(res => res.json())
  .then(data => {
    mostrarToast('✅ Evento registrado. ' + (data.recordatorio || 'Recuerde comunicarse con el estudiante por teléfono, correo u otro medio'));
    cerrarModalEvento();
    e.target.reset();
    renderCalendar();
  })
  .catch(() => {
    mostrarToast('✅ Evento registrado localmente. Recuerde comunicarse con el estudiante por teléfono, correo u otro medio');
    cerrarModalEvento();
    e.target.reset();
  });
}

function mostrarToast(msg) {
  const toastEl = document.getElementById('calToast');
  document.getElementById('calToastMsg').textContent = msg;
  const toast = new bootstrap.Toast(toastEl, { delay: 4500 });
  toast.show();
}

// ── Inicialización ──
document.addEventListener('DOMContentLoaded', () => {
  renderCalendar();
});
</script>

