<section
  class="container py-5 report-flow"
  id="report-flow"
  data-status-labels="<%= JSON.stringify(statusLabels) %>"
  data-urgency-labels="<%= JSON.stringify(urgencyLabels) %>"
  data-sections="<%= JSON.stringify(sections) %>"
>
  <div class="page-heading">
    <div>
      <p class="eyebrow">Acompañamiento estudiantil</p>
      <h1>Generar reporte</h1>
      <p class="text-muted mb-0">Selecciona un caso para comenzar.</p>
    </div>
  </div>
  <ol class="report-steps mt-4" aria-label="Pasos para generar el reporte">
    <li class="is-current" data-step-indicator="1" aria-current="step"><span>1</span> Seleccionar caso</li>
    <li data-step-indicator="2"><span>2</span> Configurar contenido</li>
    <li data-step-indicator="3"><span>3</span> Previsualizar</li>
  </ol>
  <div class="report-alert" id="report-error" role="alert" hidden></div>
  <p class="visually-hidden" id="report-announcement" aria-live="polite"></p>

  <section class="report-step-panel mt-4" data-step="1" aria-labelledby="report-case-title">
    <div>
      <p class="eyebrow">Paso 1 de 3</p>
      <h2 id="report-case-title" tabindex="-1">Selecciona un caso</h2>
      <p>Busca por nombre del estudiante, correo o identificador del caso.</p>
    </div>
    <div class="report-search">
      <label class="form-label" for="report-search">Buscar caso</label>
      <input class="form-control" id="report-search" type="search" autocomplete="off" placeholder="Ej. Valentina, correo o EN-2026-001">
      <span class="form-text">Se muestran únicamente casos de tu ámbito.</span>
    </div>
    <p class="report-loading" id="report-search-loading" role="status" hidden>Buscando casos…</p>
    <div class="report-case-results" id="report-case-results" aria-label="Resultados de casos">
      <% if (cases.length) { %>
        <% cases.forEach((studentCase) => { %>
          <button
            class="report-case-option"
            type="button"
            data-case-id="<%= studentCase.id %>"
            data-case-name="<%= studentCase.studentName %>"
            data-case-program="<%= studentCase.program %>"
            data-case-status="<%= studentCase.status %>"
            data-case-urgency="<%= studentCase.urgency %>"
            aria-pressed="false"
          >
            <span class="report-case-top">
              <span class="case-id"><%= studentCase.id %></span>
              <span class="urgency-chip urgency-<%= studentCase.urgency.toLowerCase() %>"><span aria-hidden="true"><%= studentCase.urgency === 'ALTA' ? '!' : studentCase.urgency === 'MEDIA' ? '◷' : '✓' %></span> Urgencia <%= urgencyLabels[studentCase.urgency] %></span>
            </span>
            <strong><%= studentCase.studentName %></strong>
            <span><%= studentCase.program %></span>
            <span class="status-chip status-<%= studentCase.status.toLowerCase() %>"><span aria-hidden="true"><%= statusIcons[studentCase.status] %></span><%= statusLabels[studentCase.status] %></span>
          </button>
        <% }) %>
      <% } else { %>
        <div class="report-empty">
          <h3>No tienes casos disponibles</h3>
          <p>Registra un caso para poder generar un reporte.</p>
          <a class="btn btn-primary-action" href="/casos/nuevo">Registrar un caso</a>
        </div>
      <% } %>
    </div>
    <div class="report-navigation">
      <span class="text-muted" id="selected-case-label">Selecciona un caso para continuar.</span>
      <button class="btn btn-primary-action" id="report-continue" type="button" disabled>Continuar</button>
    </div>
  </section>

  <section class="report-step-panel mt-4" data-step="2" aria-labelledby="report-config-title" hidden>
    <div>
      <p class="eyebrow">Paso 2 de 3</p>
      <h2 id="report-config-title" tabindex="-1">Configura el contenido</h2>
      <p>Elige las secciones que necesitas incluir.</p>
    </div>
    <div class="report-case-context" id="report-case-context"></div>
    <div class="report-section-heading">
      <h3>Secciones del reporte</h3>
      <button class="btn btn-outline-secondary btn-sm" id="toggle-all-sections" type="button">Desmarcar todas</button>
    </div>
    <fieldset class="report-section-options">
      <legend class="visually-hidden">Selecciona las secciones para incluir</legend>
      <% sections.forEach((section) => { %>
        <label class="report-section-option" for="section-<%= section.id %>">
          <input class="form-check-input" id="section-<%= section.id %>" type="checkbox" data-section-id="<%= section.id %>" checked>
          <span><strong><%= section.nombre %></strong><small><%= section.descripcionCorta %></small></span>
        </label>
      <% }) %>
    </fieldset>
    <p class="report-selection-count" id="configuration-count" aria-live="polite"></p>
    <p class="report-soft-warning" id="empty-selection-warning" role="status" hidden>No has seleccionado secciones. El reporte descargado estará prácticamente vacío.</p>
    <div class="report-navigation">
      <button class="btn btn-outline-secondary" type="button" data-go-to="1">Volver</button>
      <button class="btn btn-primary-action" type="button" data-go-to="3">Previsualizar</button>
    </div>
  </section>
  <section class="report-step-panel mt-4" data-step="3" aria-labelledby="report-preview-title" hidden>
    <div>
      <p class="eyebrow">Paso 3 de 3</p>
      <h2 id="report-preview-title" tabindex="-1">Previsualizar</h2>
      <p>La vista previa se añadirá en el siguiente entregable.</p>
    </div>
    <div class="report-navigation">
      <button class="btn btn-outline-secondary" type="button" data-go-to="2">Volver</button>
    </div>
  </section>
  <script src="/js/report-flow.js" defer></script>
</section>
