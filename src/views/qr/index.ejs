/* Modo Impresión de Afiche */
@media print {
  body * {
    visibility: hidden;
  }
  .qr-card-main, .qr-card-main * {
    visibility: visible;
  }
  .qr-card-main {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    box-shadow: none;
    border: none;
  }
  .qr-action-buttons, .cal-header-buttons, .sidebar, .mobile-header, .site-footer {
    display: none !important;
  }
