  align-items: center;
  gap: 1rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  transition: transform 0.2s, box-shadow 0.2s;
}

.qr-kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.06);
}

.qr-kpi-card--blue { border-left: 4px solid #3b82f6; }
.qr-kpi-card--green { border-left: 4px solid #22c55e; }
.qr-kpi-card--orange { border-left: 4px solid #f97316; }
.qr-kpi-card--purple { border-left: 4px solid #a855f7; }

.qr-kpi-icon {
  font-size: 2rem;
  line-height: 1;
}

.qr-kpi-val {
  font-size: 1.75rem;
  font-weight: 800;
  line-height: 1.1;
  color: var(--color-text);
}

.qr-kpi-lbl {
  font-size: 0.82rem;
  color: var(--color-muted);
  font-weight: 600;
}

/* Pasos para estudiantes */
.student-steps-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

@media (max-width: 640px) {
  .student-steps-grid {
    grid-template-columns: 1fr;
  }
}

.step-card {
  background: #f8fafc;
  border: 1px solid #edf2f7;
  border-radius: 14px;
  padding: 1rem;
  display: flex;
  gap: 0.85rem;
  align-items: flex-start;
  transition: background 0.15s;
}

.step-card:hover {
  background: #f0fdfa;
