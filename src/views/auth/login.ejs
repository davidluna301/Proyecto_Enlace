<section class="login-card" aria-labelledby="login-title">
  <div class="login-brand">
    <img src="/img/logo.png" alt="Universidad Cooperativa de Colombia" class="login-logo">
    <span class="login-divider" aria-hidden="true"></span>
    <img src="/img/logolink.png" alt="ENLACE" class="login-link-logo">
  </div>
  <p class="eyebrow">Plataforma de acompañamiento</p>
  <h1 id="login-title">Qué bueno tenerte aquí</h1>
  <p class="text-muted mb-4">Ingresa para continuar acompañando a nuestros estudiantes.</p>
  <% if (error) { %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
  <% } %>
  <form action="/login" method="post">
    <div class="mb-3">
      <label class="form-label" for="email">Correo institucional</label>
      <input class="form-control form-control-lg" id="email" name="email" type="email" autocomplete="username" required autofocus value="<%= typeof email === 'string' ? email : '' %>">
    </div>
    <div class="mb-4">
      <label class="form-label" for="password">Contraseña</label>
      <input class="form-control form-control-lg" id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn btn-primary-action btn-lg w-100" type="submit">Ingresar <span aria-hidden="true">→</span></button>
  </form>
  <p class="login-help mt-4 mb-0">Si necesitas ayuda para ingresar, comunícate con el equipo de acompañamiento.</p>
</section>
