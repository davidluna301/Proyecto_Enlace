<section class="login-card login-card--elevated" aria-labelledby="login-title">
  <div class="login-card-top-badge">
    <span class="badge-institutional">🏛️ Universidad Cooperativa de Colombia</span>
    <span class="badge-secure">🔒 Acceso Seguro</span>
  </div>

  <div class="login-brand">
    <img src="/img/logo.png" alt="Universidad Cooperativa de Colombia" class="login-logo">
    <span class="login-divider" aria-hidden="true"></span>
    <img src="/img/logolink.png" alt="ENLACE UCC" class="login-link-logo">
  </div>

  <div class="login-header-group">
    <p class="eyebrow">Plataforma de acompañamiento</p>
    <h1 id="login-title">Qué bueno tenerte aquí</h1>
    <p class="login-subtitle">Ingresa para continuar acompañando a nuestros estudiantes en su permanencia y bienestar universitario.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger alert-login-custom" role="alert">
      <span class="alert-icon">⚠️</span>
      <div><%= error %></div>
    </div>
  <% } %>

  <form action="/login" method="post" id="login-form">
    <div class="mb-3">
      <label class="form-label" for="email">
        <span>✉️</span> Correo institucional
      </label>
      <div class="input-with-icon">
        <input 
          class="form-control form-control-lg form-input-styled" 
          id="email" 
          name="email" 
          type="email" 
          placeholder="tu.nombre@ucc.edu.co"
          autocomplete="username" 
          required 
          autofocus 
          value="<%= typeof email === 'string' ? email : '' %>"
        >
      </div>
      <small class="form-hint">Usa tu cuenta institucional @campusucc.edu.co o @ucc.edu.co</small>
    </div>

    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <label class="form-label mb-0" for="password">
          <span>🔒</span> Contraseña
        </label>
        <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility()" aria-label="Mostrar u ocultar contraseña">
          <span id="pwd-icon">👁️</span> <span id="pwd-text" style="font-size:0.75rem;">Mostrar</span>
        </button>
      </div>
      <div class="input-with-icon">
        <input 
          class="form-control form-control-lg form-input-styled" 
          id="password" 
          name="password" 
          type="password" 
          placeholder="Ingresa tu contraseña"
          autocomplete="current-password" 
          required
        >
      </div>
    </div>

    <%# Botones de Cuentas Demo para Evaluación Inmediata %>
    <div class="demo-accounts-pillbox mb-3">
      <span class="demo-pillbox-label">⚡ Acceso rápido de demostración:</span>
      <div class="demo-buttons-group">
        <button type="button" class="btn-demo-pill" onclick="fillDemo('asesor@ucc.edu.co', 'Asesor123*')">
          🧑‍💼 Asesor
        </button>
        <button type="button" class="btn-demo-pill" onclick="fillDemo('admin@ucc.edu.co', 'Admin123*')">
          🛡️ Administrador
        </button>
      </div>
    </div>

    <button class="btn btn-primary-action btn-lg w-100 btn-login-submit" type="submit">
      <span>Ingresar a la plataforma</span>
      <span aria-hidden="true" class="submit-arrow">→</span>
    </button>
  </form>

  <div class="login-footer-links">
    <a href="/portal-estudiante" class="link-back-portal">
      <span>←</span> Volver al Portal Estudiantil
    </a>
  </div>

  <p class="login-help mt-4 mb-0">Si necesitas ayuda para ingresar, comunícate con el equipo de acompañamiento.</p>
</section>

<script>
function togglePasswordVisibility() {
  const pwd = document.getElementById('password');
  const icon = document.getElementById('pwd-icon');
  const text = document.getElementById('pwd-text');
  if (pwd.type === 'password') {
    pwd.type = 'text';
    icon.textContent = '🙈';
    text.textContent = 'Ocultar';
  } else {
    pwd.type = 'password';
    icon.textContent = '👁️';
    text.textContent = 'Mostrar';
  }
}

function fillDemo(email, password) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = password;
  const submitBtn = document.querySelector('.btn-login-submit');
  submitBtn.classList.add('pulse-focus');
  setTimeout(() => submitBtn.classList.remove('pulse-focus'), 800);
}
</script>
