<%# views/ia/predicciones.ejs – Panel de Predicción IA – Falsos Positivos ENLACE UCC %>
<div class="dashboard-wrapper container-fluid px-3 px-md-4 py-4">

  <%# Encabezado principal %>
  <div class="cal-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <p class="eyebrow-dark mb-1">🤖 Inteligencia Artificial & Analítica Preventiva</p>
      <h1 class="h2 fw-bold text-dark mb-1">Predicción – Falsos Positivos</h1>
      <p class="cal-subtitle text-muted mb-0">
        Detección temprana de anomalías en justificaciones, reportes extemporáneos e inconsistencias en acompañamiento.
      </p>
    </div>
    <div class="ia-status-badge d-flex flex-column align-items-md-end gap-1">
      <span class="badge rounded-pill px-3 py-2 bg-success-subtle text-success border border-success-subtle fw-semibold">
        🟢 Motor Heurístico Activo
      </span>
      <small class="text-muted">Última actualización: <%= stats.lastUpdated %></small>
    </div>
  </div>

  <%# Resumen estadístico / KPIs superiores %>
  <div class="kpi-grid mb-4">
    <div class="kpi-card kpi-card--orange">
      <div class="kpi-card__icon">⚠️</div>
      <div>
        <div class="kpi-card__value" id="kpi-active-alerts"><%= stats.activeAlerts %></div>
        <div class="kpi-card__label">Alertas activas</div>
      </div>
    </div>
    <div class="kpi-card kpi-card--red" style="border-left-color: #ef4444;">
      <div class="kpi-card__icon" style="background: #fee2e2; color: #dc2626;">🚨</div>
      <div>
        <div class="kpi-card__value text-danger" id="kpi-high-risk"><%= stats.highRiskCount %></div>
        <div class="kpi-card__label">Riesgo alto</div>
      </div>
    </div>
    <div class="kpi-card kpi-card--green">
      <div class="kpi-card__icon">✅</div>
      <div>
        <div class="kpi-card__value text-success"><%= stats.totalAnalyzed %></div>
        <div class="kpi-card__label">Casos analizados</div>
      </div>
    </div>
    <div class="kpi-card kpi-card--blue">
      <div class="kpi-card__icon">📊</div>
      <div>
        <div class="kpi-card__value text-primary"><%= stats.modelAccuracy %>%</div>
        <div class="kpi-card__label">Precisión estimada</div>
      </div>
    </div>
  </div>

  <%# Card educativa: Cómo funciona el modelo %>
  <div class="dash-card ia-info-card mb-4 p-4 rounded-4 shadow-sm">
    <div class="dash-card__header pb-2 mb-3 border-bottom">
      <h2 class="h5 fw-bold text-dark m-0">🧠 Criterios y patrones evaluados por la IA</h2>
      <span class="badge bg-light text-secondary border">Auditoría ética algorítmica</span>
    </div>
    <div class="ia-criteria-grid">
      <div class="ia-criterion">
        <span class="ia-criterion-icon">📅</span>
        <div>
          <strong>Reporte tardío / Extemporáneo</strong>
          <p>Solicitudes radicadas en las semanas 12 a 16 para justificar dificultades no notificadas durante el semestre.</p>
        </div>
      </div>
      <div class="ia-criterion">
        <span class="ia-criterion-icon">📉</span>
        <div>
          <strong>Patrón de ausencias finales</strong>
          <p>Inasistencias concentradas en vísperas de parciales o entregas evaluativas críticas.</p>
        </div>
      </div>
      <div class="ia-criterion">
        <span class="ia-criterion-icon">🔄</span>
        <div>
          <strong>Inconsistencia del relato</strong>
          <p>Discrepancias entre las causales expuestas inicialmente y las declaraciones en sesiones posteriores.</p>
        </div>
      </div>
      <div class="ia-criterion">
        <span class="ia-criterion-icon">📋</span>
        <div>
          <strong>Justificación simultánea masiva</strong>
          <p>Uso de un mismo suceso para justificar faltas y evaluaciones no presentadas en la totalidad de cursos.</p>
        </div>
      </div>
    </div>
  </div>

  <%# Barra de filtros y pestañas %>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div class="btn-group filter-btn-group" role="group" aria-label="Filtro de riesgo">
      <button type="button" class="btn btn-outline-secondary btn-sm active" data-filter="all">
        Todos (<%= predictions.length %>)
      </button>
      <button type="button" class="btn btn-outline-danger btn-sm" data-filter="ALTO">
        Riesgo alto (<%= stats.highRiskCount %>)
      </button>
      <button type="button" class="btn btn-outline-warning btn-sm" data-filter="MEDIO">
        Riesgo medio (<%= stats.mediumRiskCount %>)
      </button>
      <button type="button" class="btn btn-outline-success btn-sm" data-filter="BAJO">
        Riesgo bajo (<%= stats.lowRiskCount %>)
      </button>
      <button type="button" class="btn btn-outline-primary btn-sm" data-filter="REVISADO">
        Revisados (<span id="count-reviewed"><%= stats.reviewedCount %></span>)
      </button>
    </div>

    <div class="search-box">
      <input type="text" id="ia-search-input" class="form-control form-control-sm" placeholder="Buscar por estudiante o caso..." aria-label="Buscar caso">
    </div>
  </div>

  <%# Lista de casos analizados por IA %>
  <div class="dash-card p-4 rounded-4 shadow-sm">
    <div class="dash-card__header pb-3 mb-3 border-bottom d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <h2 class="h5 fw-bold text-dark m-0">⚡ Casos Evaluados por el Modelo Predictivo</h2>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold">
          <%= predictions.length %> Casos Clasificados
        </span>
      </div>
      <small class="text-muted">Ordenados por nivel de riesgo heurístico</small>
    </div>

    <div class="ia-cases-list d-flex flex-column gap-3" id="ia-cases-container">
      <% if (predictions && predictions.length > 0) { %>
        <% predictions.forEach((item) => { 
             const cardClass = item.riskLevel === 'ALTO' ? 'ia-case-card--high' : (item.riskLevel === 'MEDIO' ? 'ia-case-card--medium' : 'ia-case-card--low');
             const badgeClass = item.riskLevel === 'ALTO' ? 'ia-risk-badge--high' : (item.riskLevel === 'MEDIO' ? 'ia-risk-badge--medium' : 'ia-risk-badge--low');
             const circleClass = item.riskLevel === 'ALTO' ? 'ia-score-circle--high' : (item.riskLevel === 'MEDIO' ? 'ia-score-circle--medium' : 'ia-score-circle--low');
             const riskIcon = item.riskLevel === 'ALTO' ? '🔴' : (item.riskLevel === 'MEDIO' ? '🟠' : '🟢');
        %>
          <div class="ia-case-card <%= cardClass %> <%= item.status === 'REVISADO' ? 'is-reviewed' : '' %>"
               data-case-id="<%= item.caseId %>"
               data-risk="<%= item.riskLevel %>"
               data-status="<%= item.status %>"
               data-student="<%= item.studentName.toLowerCase() %>"
               data-program="<%= item.program.toLowerCase() %>">
            
            <div class="ia-case-header">
              <div class="ia-case-info">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                  <span class="ia-risk-badge <%= badgeClass %>">
                    <%= riskIcon %> Riesgo <%= item.riskLevel.toLowerCase() %>
                  </span>
                  <span class="badge bg-light text-dark border">
                    <%= item.caseId %>
                  </span>
                  <% if (item.status === 'REVISADO') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle status-pill">
                      ✓ Revisado
                    </span>
                  <% } else if (item.status === 'SENSIBLE') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle status-pill">
                      ⚠️ Tratamiento Sensible
                    </span>
                  <% } %>
                </div>
                <strong class="fs-5 text-dark"><%= item.studentName %></strong>
                <span class="text-muted">
                  <%= item.program %> · <strong><%= item.semester %></strong> · Asesor: <%= item.advisorName %>
                </span>
              </div>

              <div class="ia-case-score text-center">
                <div class="ia-score-circle <%= circleClass %>">
                  <%= item.riskScore %>%
                </div>
                <small class="text-muted mt-1 d-block fw-semibold">Riesgo IA</small>
              </div>
            </div>

            <div class="ia-case-body">
              <div class="ia-summary-box mb-2 p-2 px-3 bg-white bg-opacity-75 rounded-2 border">
                <span class="text-secondary fw-semibold small">Resumen del caso:</span>
                <p class="m-0 text-dark small"><%= item.shortDescription %></p>
              </div>

              <div class="ia-pattern-box">
                <p class="ia-pattern-title">📌 Patrón detectado por la IA:</p>
                <p class="m-0">"<%= item.patternDetected %>"</p>
              </div>

              <div class="ia-flags mt-2">
                <% item.flags.forEach((flag) => { %>
                  <span class="ia-flag"><%= flag %></span>
                <% }) %>
              </div>
            </div>

            <div class="ia-case-actions">
              <a href="/casos/<%= item.caseId %>" class="btn btn-sm btn-primary-action text-decoration-none">
                🔍 Ver caso completo
              </a>
              <button type="button" 
                      class="btn btn-sm btn-outline-secondary btn-mark-reviewed" 
                      data-id="<%= item.caseId %>"
                      <%= item.status === 'REVISADO' ? 'disabled' : '' %>>
                <%= item.status === 'REVISADO' ? '✅ Revisado' : '✅ Marcar como revisado' %>
              </button>
              <button type="button" 
                      class="btn btn-sm btn-outline-warning btn-mark-sensitive" 
                      data-id="<%= item.caseId %>"
                      <%= item.status === 'SENSIBLE' ? 'disabled' : '' %>>
                ⚠️ Marcar como sensible
              </button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-5">
          <div class="fs-1 mb-2">🎉</div>
          <h3 class="h5 fw-bold">Sin anomalías detectadas</h3>
          <p class="text-muted">No se identificaron casos con riesgo de falsos positivos en el semestre actual.</p>
        </div>
      <% } %>
    </div>
  </div>

</div>

<%# Toast de notificación para acciones %>
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
  <div id="ia-toast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="ia-toast-message">
        Acción completada exitosamente.
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
    </div>
  </div>
</div>

<style>
/* ── Estilos Premium de Predicción IA ENLACE UCC ── */
.dashboard-wrapper {
  max-width: 1300px;
  margin: 0 auto;
}
.eyebrow-dark {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--color-primary-dark, #0e6577);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.cal-subtitle {
  font-size: 0.92rem;
}
.ia-status-badge span {
  font-size: 0.82rem;
}

/* Info card con degradado suave */
.ia-info-card {
  background: linear-gradient(135deg, #f8faff 0%, #eef6fc 100%);
  border: 1px solid #dce8f5;
}
.ia-criteria-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.25rem;
}
.ia-criterion {
  display: flex;
  gap: 0.85rem;
  align-items: flex-start;
}
.ia-criterion-icon {
  font-size: 1.6rem;
  line-height: 1;
}
.ia-criterion strong {
  display: block;
  font-size: 0.88rem;
  color: #1e293b;
  margin-bottom: 0.2rem;
}
.ia-criterion p {
  font-size: 0.8rem;
  color: #64748b;
  margin: 0;
  line-height: 1.45;
}

/* Casos IA Cards */
.ia-cases-list {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.ia-case-card {
  border-radius: 16px;
  padding: 1.35rem;
  border: 1px solid #e2e8f0;
  background: #ffffff;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  position: relative;
}
.ia-case-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}

/* Estados por nivel de riesgo */
.ia-case-card--high {
  background: #fff8f8;
  border-color: #fecaca;
  border-left: 5px solid #dc2626;
}
.ia-case-card--medium {
  background: #fffbf5;
  border-color: #fed7aa;
  border-left: 5px solid #ea580c;
}
.ia-case-card--low {
  background: #fbfdf9;
  border-color: #d1fae5;
  border-left: 5px solid #16a34a;
}
.ia-case-card.is-reviewed {
  opacity: 0.85;
  filter: grayscale(15%);
}

.ia-case-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1rem;
}
.ia-case-info {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.ia-risk-badge {
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: 20px;
  padding: 3px 12px;
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.ia-risk-badge--high { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; }
.ia-risk-badge--medium { background: #ffedd5; color: #c2410c; border: 1px solid #fdba74; }
.ia-risk-badge--low { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }

/* Score circular */
.ia-score-circle {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 0.95rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}
.ia-score-circle--high { background: #fee2e2; color: #991b1b; border: 2px solid #ef4444; }
.ia-score-circle--medium { background: #ffedd5; color: #9a3412; border: 2px solid #f97316; }
.ia-score-circle--low { background: #dcfce7; color: #166534; border: 2px solid #22c55e; }

/* Patrón detectado */
.ia-pattern-box {
  background: #ffffff;
  border-radius: 10px;
  padding: 0.9rem 1.1rem;
  margin-bottom: 0.75rem;
  font-size: 0.88rem;
  line-height: 1.55;
  color: #334155;
  border-left: 3.5px solid var(--color-primary, #189fba);
  box-shadow: inset 0 0 0 1px #f1f5f9;
}
.ia-pattern-title {
  font-weight: 700;
  margin-bottom: 0.3rem;
  color: #0f172a;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

/* Chips / Flags */
.ia-flags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}
.ia-flag {
  background: #f1f5f9;
  color: #334155;
  border-radius: 8px;
  padding: 3px 10px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid #e2e8f0;
}

/* Acciones */
.ia-case-actions {
  display: flex;
  gap: 0.65rem;
  margin-top: 1.15rem;
  flex-wrap: wrap;
  align-items: center;
}
.btn-primary-action {
  background: var(--color-primary, #189fba);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.4rem 0.95rem;
  font-weight: 600;
  font-size: 0.85rem;
  transition: background 0.15s ease, transform 0.1s ease;
}
.btn-primary-action:hover {
  background: var(--color-primary-dark, #0e6577);
  color: #fff;
  transform: translateY(-1px);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const filterButtons = document.querySelectorAll('.filter-btn-group button');
  const searchInput = document.getElementById('ia-search-input');
  const caseCards = document.querySelectorAll('.ia-case-card');
  const toastEl = document.getElementById('ia-toast');
  const toastMessage = document.getElementById('ia-toast-message');
  const toast = new bootstrap.Toast(toastEl, { delay: 3500 });

  let currentFilter = 'all';
  let searchTerm = '';

  function applyFilters() {
    caseCards.forEach(function (card) {
      const risk = card.dataset.risk;
      const status = card.dataset.status;
      const student = card.dataset.student;
      const program = card.dataset.program;

      const matchesFilter =
        currentFilter === 'all' ||
        (currentFilter === 'REVISADO' && status === 'REVISADO') ||
        risk === currentFilter;

      const matchesSearch =
        searchTerm === '' ||
        student.includes(searchTerm) ||
        program.includes(searchTerm) ||
        card.dataset.caseId.toLowerCase().includes(searchTerm);

      if (matchesFilter && matchesSearch) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // Filtrado por botones de pestaña
  filterButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      filterButtons.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      applyFilters();
    });
  });

  // Búsqueda en tiempo real
  if (searchInput) {
    searchInput.addEventListener('input', function (e) {
      searchTerm = e.target.value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Acción: Marcar como revisado
  document.querySelectorAll('.btn-mark-reviewed').forEach(function (button) {
    button.addEventListener('click', async function () {
      const caseId = button.dataset.id;
      button.disabled = true;
      button.innerHTML = '⏳ Guardando...';

      try {
        const response = await fetch('/ia/predicciones/' + encodeURIComponent(caseId) + '/revisar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'REVISADO' }),
        });

        if (response.ok) {
          const card = document.querySelector(`.ia-case-card[data-case-id="${caseId}"]`);
          if (card) {
            card.dataset.status = 'REVISADO';
            card.classList.add('is-reviewed');
            button.innerHTML = '✅ Revisado';

            // Añadir pill visual si no existía
            const headerInfo = card.querySelector('.ia-case-info .d-flex');
            if (headerInfo && !card.querySelector('.status-pill')) {
              const pill = document.createElement('span');
              pill.className = 'badge bg-success-subtle text-success border border-success-subtle status-pill';
              pill.textContent = '✓ Revisado';
              headerInfo.appendChild(pill);
            }
          }

          // Actualizar contador
          const countReviewed = document.getElementById('count-reviewed');
          if (countReviewed) {
            countReviewed.textContent = parseInt(countReviewed.textContent || '0', 10) + 1;
          }

          toastEl.className = 'toast align-items-center text-white bg-success border-0';
          toastMessage.textContent = 'El caso ' + caseId + ' fue marcado como revisado.';
          toast.show();
        } else {
          throw new Error('Error al actualizar el caso.');
        }
      } catch (err) {
        button.disabled = false;
        button.innerHTML = '✅ Marcar como revisado';
        toastEl.className = 'toast align-items-center text-white bg-danger border-0';
        toastMessage.textContent = 'No se pudo guardar la revisión. Intente de nuevo.';
        toast.show();
      }
    });
  });

  // Acción: Marcar como sensible
  document.querySelectorAll('.btn-mark-sensitive').forEach(function (button) {
    button.addEventListener('click', async function () {
      const caseId = button.dataset.id;
      button.disabled = true;
      button.innerHTML = '⏳ Guardando...';

      try {
        const response = await fetch('/ia/predicciones/' + encodeURIComponent(caseId) + '/sensible', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'SENSIBLE' }),
        });

        if (response.ok) {
          const card = document.querySelector(`.ia-case-card[data-case-id="${caseId}"]`);
          if (card) {
            card.dataset.status = 'SENSIBLE';
            button.innerHTML = '⚠️ Marcado sensible';

            const headerInfo = card.querySelector('.ia-case-info .d-flex');
            if (headerInfo) {
              const existingPill = card.querySelector('.status-pill');
              if (existingPill) existingPill.remove();
              const pill = document.createElement('span');
              pill.className = 'badge bg-warning-subtle text-warning border border-warning-subtle status-pill';
              pill.textContent = '⚠️ Tratamiento Sensible';
              headerInfo.appendChild(pill);
            }
          }

          toastEl.className = 'toast align-items-center text-white bg-warning text-dark border-0';
          toastMessage.textContent = 'El caso ' + caseId + ' fue marcado como de tratamiento sensible.';
          toast.show();
        } else {
          throw new Error('Error al actualizar.');
        }
      } catch (err) {
        button.disabled = false;
        button.innerHTML = '⚠️ Marcar como sensible';
        toastEl.className = 'toast align-items-center text-white bg-danger border-0';
        toastMessage.textContent = 'Error al marcar como sensible.';
        toast.show();
      }
    });
  });
});
</script>
