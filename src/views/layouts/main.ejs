<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | ENLACE UCC</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <% if (currentUser) { %>
      <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark container py-3" aria-label="Navegación principal">
          <a class="navbar-brand d-flex align-items-center gap-3" href="/home" aria-label="ENLACE UCC, inicio">
            <img class="brand-institution" src="/img/logo.png" alt="Universidad Cooperativa de Colombia">
            <span class="brand-divider" aria-hidden="true"></span>
            <img class="brand-platform" src="/img/logolink.png" alt="ENLACE">
          </a>
          <div class="ms-auto d-flex align-items-center gap-3">
            <span class="user-greeting d-none d-sm-inline">Hola, <strong><%= currentUser.name.split(" ")[0] %></strong></span>
            <form action="/logout" method="post">
              <button class="btn btn-logout" type="submit">Cerrar sesión</button>
            </form>
          </div>
        </nav>
      </header>
    <% } %>
    <main id="contenido" class="<%= currentUser ? 'page-shell' : 'login-shell' %>">
      <%- body %>
    </main>
    <% if (currentUser) { %>
      <footer class="site-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
          <span>ENLACE UCC · Acompañamiento que conecta</span>
          <span>Vista de demostración</span>
        </div>
      </footer>
    <% } %>
    <script src="/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
